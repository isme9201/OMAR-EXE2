{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Avenmedia",
  "version": "2.0.0",
  "identifier": "com.avenmedia.workspace",
  "build": {
    "frontendDist": "../out",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AVEN Media Production | لوحة الإدارة",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "deb", "appimage"],
    "category": "Business",
    "shortDescription": "AVEN Media Production management workspace.",
    "longDescription": "AVEN Media Production manages requests, production, finance, portfolios, and secure file delivery.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    }
  }
}
