{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhotoMedia ERP",
  "version": "2.0.0",
  "identifier": "com.photomedia.erp",
  "build": {
    "frontendDist": "../out",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PhotoMedia ERP | مكتب الإنتاج",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "deb", "appimage"],
    "category": "Business",
    "shortDescription": "Production command desk for photography and media studios.",
    "longDescription": "PhotoMedia ERP combines bookings, production workflow, uploads, finance, equipment, and team operations in one Arabic-first studio workspace.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    }
  }
}
